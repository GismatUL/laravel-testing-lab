APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:GlZwnl6oH+EJA0db8QfTvYZnzquqzp1CeOu8p97BjR8=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=laravel
