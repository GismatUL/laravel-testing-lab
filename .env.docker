APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:GlZwnl6oH+EJA0db8QfTvYZnzquqzp1CeOu8p97BjR8=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_LIFETIME=120

MAIL_MAILER=log

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

SCOUT_DRIVER=elastic
ELASTICSEARCH_HOST=elasticsearch:9200

# Task03 – Sentry error tracking (https://sentry.io, project platform: Laravel)
# Empty DSN = SDK disabled. Paste your project DSN here, then: docker compose up -d
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=local
# Share of requests/jobs traced for performance (1.0 = all). Production: 0.05-0.2
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_SEND_DEFAULT_PII=false

# ── Prometheus metrics (Task03) ──────────────────────────────────────────────
# Counters/histograms are accumulated in this Redis database (0 = app, 1 = cache).
METRICS_ENABLED=true
METRICS_STORAGE=redis
REDIS_METRICS_DB=3

# ── Monitoring lab (Task03 phase 6) ──────────────────────────────────────────
# /api/v1/lab/* : deliberate slow requests, N+1, failing jobs, CPU/memory spikes.
# Always off in production. Local-only token: generate a new one anywhere else
# (openssl rand -hex 24). Send it as the X-Lab-Token header, or use: make lab s=slow
LAB_ENABLED=true
LAB_TOKEN=d1706b38af90057ce4cbbb6685dcbcb3ca4ca29936c54730
